<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. D-Pad Cursor steht drauf: Kräftiger Kupfer-Rahmen + hellerer Hintergrund -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A2B32" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="#C5866D" />
        </shape>
    </item>

    <!-- 2. Aktiv ausgewählte Kategorie (Fokus steht rechts in Senderliste): Mattes Dunkelkupfer OHNE aktiven Fokusrahmen -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#352219" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#6B3F2E" />
        </shape>
    </item>

    <!-- 3. Inaktives Element -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17181C" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#23242A" />
        </shape>
    </item>
</selector>
