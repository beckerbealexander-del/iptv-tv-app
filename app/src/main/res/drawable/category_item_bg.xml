<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. D-Pad Cursor steht drauf: Kräftiger roter Rahmen + hellerer Hintergrund -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E2E2E" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="#E50914" />
        </shape>
    </item>

    <!-- 2. Aktiv ausgewählte Kategorie (Fokus steht rechts in Senderliste): Mattes Dunkelrot OHNE aktiven Fokusrahmen -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#421317" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#7A2228" />
        </shape>
    </item>

    <!-- 3. Inaktives Element -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141414" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#222222" />
        </shape>
    </item>
</selector>
