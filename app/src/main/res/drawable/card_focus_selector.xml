<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A2B32" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="#C5866D" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#22232A" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#C5866D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17181C" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#23242A" />
        </shape>
    </item>
</selector>
