<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:layout_marginBottom="2dp"
    android:descendantFocusability="afterDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Schlanker Senderkopf -->
    <LinearLayout
        android:id="@+id/channelHeader"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="@drawable/card_focus_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginEnd="4dp">

        <TextView
            android:id="@+id/txtChannelNum"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgChannelLogo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/tv_banner" />

        <!-- Dynamischer roter Indikator-Punkt für aktuell laufenden Sender -->
        <View
            android:id="@+id/dotChannelIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/red_circle_badge"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text="Sendername"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSourceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="#262626"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="3 Q."
            android:textColor="#AAAAAA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Rechter horizontaler EPG Timeline Zeitstrahl -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChannelPrograms"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal" />

</LinearLayout>
