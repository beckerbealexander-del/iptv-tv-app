<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal">

    <!-- Linke Spalte: Suche + Filter + Serien-Kategorien -->
    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:background="#0B0B0B"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serien-Kategorien"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- 1. Suchleiste ÜBER den Filter-Buttons -->
        <EditText
            android:id="@+id/editSeriesSearch"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/card_focus_selector"
            android:hint="🔍 Serie suchen..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="11sp"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:layout_marginBottom="6dp" />

        <!-- 2. Schnellauswahl Filter-Buttons (DE, RU, Alle) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnSeriesFilterDe"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🇩🇪 DE"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnSeriesFilterRu"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🇷🇺 RU"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnSeriesFilterAll"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🌍 Alle"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSeriesCats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSeriesCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Rechte Spalte: Hero Banner & Series Grid -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Kopfzeile mit Kategorie-Titel und Sortier-Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txtSeriesCategoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Serien"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Sortier-Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSeriesSortDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/card_focus_selector"
                    android:text="⚡ Standard"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnSeriesSortRating"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/card_focus_selector"
                    android:text="⭐ Bewertung"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnSeriesSortYear"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/card_focus_selector"
                    android:text="📅 Neu"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:paddingHorizontal="6dp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnSeriesSortAlpha"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/card_focus_selector"
                    android:text="🔤 A-Z"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp"
                    android:paddingHorizontal="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Kompakter Hero Banner -->
        <LinearLayout
            android:id="@+id/seriesHeroBanner"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#151515"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/imgHeroSeriesCover"
                android:layout_width="60dp"
                android:layout_height="84dp"
                android:scaleType="centerCrop"
                android:src="@drawable/tv_banner"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeroSeriesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Serientitel"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeroSeriesRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="⭐ 8.5 | Staffeln &amp; Folgen"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeroSeriesHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="▶ OK zur Episodenauswahl"
                    android:textColor="@color/netflix_red"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSeries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSeriesGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

</LinearLayout>
