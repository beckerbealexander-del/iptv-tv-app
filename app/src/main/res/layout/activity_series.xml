<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal">

    <!-- Linke Spalte: Kategorien (210dp) -->
    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:background="#0B0B0B"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serien-Kategorien"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Vollbild-Suchbutton -->
        <TextView
            android:id="@+id/btnOpenSeriesSearch"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="🔍 Serie suchen..."
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressSeriesCats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSeriesCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <requestFocus />
        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>

    <!-- Rechte Spalte: Hero Banner & Series Grid -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Kategorie-Titel & Positionscounter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txtSeriesCategoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Serien"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSeriesCategoryCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_gold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="" />
        </LinearLayout>

        <!-- Kompakter Hero Banner -->
        <LinearLayout
            android:id="@+id/seriesHeroBanner"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#151515"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/imgHeroSeriesCover"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/tv_banner"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeroSeriesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Titel der Serie"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee" />

                <TextView
                    android:id="@+id/txtHeroSeriesRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 8.5 | Staffeln &amp; Folgen"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/txtHeroSeriesPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wähle eine Serie aus dem Katalog aus oder nutze die Suche."
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>



        <ProgressBar
            android:id="@+id/progressSeries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 5-Spalten Series Poster Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSeriesGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
