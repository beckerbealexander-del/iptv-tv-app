<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="36dp">

    <!-- Titel -->
    <TextView
        android:id="@+id/txtSearchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔍 Suche"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- Vollbreite Suchleiste: Tastatur-Enter löst Suche direkt aus -->
    <EditText
        android:id="@+id/editSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/card_focus_selector"
        android:hint="Suchbegriff eingeben (z. B. Sky, Pro7, Harry Potter, Lost)..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="16sp"
        android:paddingHorizontal="20dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:nextFocusDown="@+id/recyclerSearchHistory"
        android:layout_marginBottom="28dp" />

    <!-- Such-Historie Sektion -->
    <LinearLayout
        android:id="@+id/layoutSearchHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHistoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 Letzte Suchen:"
            android:textColor="@color/accent_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

</LinearLayout>
