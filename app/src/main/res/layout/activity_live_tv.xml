<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLiveTv"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Die vollständige 2-Spalten Live TV Übersicht -->
    <LinearLayout
        android:id="@+id/layoutOverview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="horizontal">

        <!-- Linke Spalte: Suche + TV-Kategorien -->
        <LinearLayout
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:background="#0B0B0B"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TV-Kategorien"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Such-Button öffnet Vollbild-Suche -->
            <TextView
                android:id="@+id/btnOpenLiveSearch"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/card_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:text="🔍 Sender suchen..."
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/progressCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>

        <!-- Rechte Spalte: TiviMate Style EPG Grid + PIP Mini-Player Anchor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- 1. Obere Leiste: PIP Mini-Player Anker + Sendungsinfos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:background="#121212"
                android:orientation="horizontal"
                android:padding="6dp"
                android:layout_marginBottom="6dp">

                <!-- PIP Player Anker (wird zur exakten Positionierung des Player-Containers genutzt) -->
                <FrameLayout
                    android:id="@+id/pipAnchor"
                    android:layout_width="190dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp" />

                <!-- Sendungsinfos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtPreviewTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Wähle einen Sender"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPreviewTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/netflix_red"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 3. Fortschrittsbalken für die aktuelle Sendung -->
                    <ProgressBar
                        android:id="@+id/progressCurrentProgram"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginVertical="3dp"
                        android:progress="0"
                        android:progressTint="@color/netflix_red"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtPreviewDesc"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="Drücke OK auf der Fernbedienung, um den Sender im Vollbild zu starten."
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. TiviMate Zeitstrahl-Kopfleiste (Jetzt & Zukunft) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:background="#181818"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/txtCurrentLiveTime"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="🔴 LIVE TV GUIDE"
                    android:textColor="@color/netflix_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 JETZT"
                    android:textColor="@color/netflix_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Als Nächstes ▶"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressChannels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- 3. Senderzeilen mit horizontalem EPG Timeline Zeitstrahl -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChannels"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>

    </LinearLayout>

    <!-- 2. Integrierter Such-Overlay (PIP läuft oben rechts unterbrechungsfrei sichtbar weiter!) -->
    <LinearLayout
        android:id="@+id/layoutSearchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Linker Suchbereich mit dunklem Hintergrund -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FA0B0B0B"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Live TV Sender durchsuchen"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/editSearchOverlayQuery"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/card_focus_selector"
                android:hint="Sendername eingeben (z. B. Sky, Pro7, ZDF)..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:nextFocusDown="@+id/recyclerSearchOverlayHistory"
                android:layout_marginBottom="24dp" />

            <!-- Such-Historie Sektion -->
            <LinearLayout
                android:id="@+id/layoutSearchOverlayHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 Letzte Suchen:"
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSearchOverlayHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Rechter Bereich: 230dp komplett transparent für den PiP-Player oben rechts -->
        <View
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />
    </LinearLayout>

    <!-- 3. Gemeinsamer Player-Container (Skaliert nahtlos zwischen Mini-PIP und Vollbild) -->
    <FrameLayout
        android:id="@+id/livePlayerContainer"
        android:layout_width="190dp"
        android:layout_height="103dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/livePlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="zoom" />

        <!-- 1. Visueller Fokus-Rahmen ÜBER der SurfaceView -->
        <View
            android:id="@+id/pipFocusBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pip_focus_border"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 4. On-Screen-Display (OSD) für Vollbildmodus bei Klick auf OK -->
    <LinearLayout
        android:id="@+id/layoutFullscreenOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6101010"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtOsdChannelNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/netflix_red"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/txtOsdChannelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sendername"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Tech-Specs Badge -->
            <TextView
                android:id="@+id/txtOsdTechSpecs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#242424"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="1920x1080 | 50 fps | H.264 | AAC"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtOsdProgramTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 JETZT: Sendungstitel"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <ProgressBar
                android:id="@+id/progressOsdProgram"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:progress="50"
                android:progressTint="@color/netflix_red"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/txtOsdProgramTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:15 - 21:45"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtOsdProgramDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sendungsbeschreibung..."
            android:textColor="@color/text_secondary"
            android:textSize="11.5sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="3dp" />
    </LinearLayout>

</FrameLayout>
