<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2D2D2D" />
            <corners android:radius="6dp" />
            <stroke android:width="3dp" android:color="#E50914" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#242424" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#E50914" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141414" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#222222" />
        </shape>
    </item>
</selector>
