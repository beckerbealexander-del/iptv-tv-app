<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- ExoPlayer Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Lade-Spinner -->
    <ProgressBar
        android:id="@+id/playerLoading"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Top OSD: Titel & Qualitäts-Badges -->
    <LinearLayout
        android:id="@+id/osdTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#DD0D1117"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Titel"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Qualitäts Badge -->
        <TextView
            android:id="@+id/badgeQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_focus_selector"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="HD"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <!-- Audio Info Badge -->
        <TextView
            android:id="@+id/badgeAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_focus_selector"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Stereo"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom OSD: Timeline, Spulen & Menü (VOD & Live) -->
    <LinearLayout
        android:id="@+id/osdBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#EE0D1117"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Live EPG Untertitel / Info -->
        <TextView
            android:id="@+id/txtPlayerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent_gold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Timeline Zeitleiste & SeekBar -->
        <LinearLayout
            android:id="@+id/layoutTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtTimeCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:id="@+id/txtTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Schnellwahltasten für Fernbedienung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/card_focus_selector"
                android:text="⏸ Pause (OK)"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnAudioTracks"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/card_focus_selector"
                android:text="🔊 Tonspur"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btnSubtitles"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/card_focus_selector"
                android:text="💬 Untertitel"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/txtHintControls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="◀ / ▶ 10s spulen | ▲ Menü"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
