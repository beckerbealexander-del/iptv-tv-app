<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Titel -->
    <TextView
        android:id="@+id/txtSearchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔍 Live TV Dual-Suche"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Vollbreite Suchleiste: Tastatur-Enter löst Suche direkt aus -->
    <EditText
        android:id="@+id/editSearchQuery"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/card_focus_selector"
        android:hint="Sendername oder Live-Sendung eingeben (z. B. Sky, ZDF, Fußball, Tatort)..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="15sp"
        android:paddingHorizontal="18dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:nextFocusDown="@+id/layoutTabs"
        android:layout_marginBottom="16dp" />

    <!-- Filter-Tabs direkt unter dem Suchfeld -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnTabAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="⭐ Alle Treffer"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/btnTabChannels"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="📺 Sender (0)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/btnTabPrograms"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="🔴 Live-Programm (0)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Such-Historie Sektion (wird angezeigt wenn Suchfeld leer ist) -->
    <LinearLayout
        android:id="@+id/layoutSearchHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtHistoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 Letzte Suchen:"
            android:textColor="@color/accent_gold"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <!-- Ladeindikator -->
    <ProgressBar
        android:id="@+id/progressSearch"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <!-- Text wenn keine Treffer -->
    <TextView
        android:id="@+id/txtNoResults"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:text="Keine Treffer gefunden."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Suchergebnisse Liste (Vertikal) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone" />

</LinearLayout>
