<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal">

    <!-- Linke Spalte: Filter & Kategorien -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="#161616"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serien-Kategorien"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Schnellauswahl Filter-Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnSeriesFilterDe"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🇩🇪 DE"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnSeriesFilterRu"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🇷🇺 RU"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnSeriesFilterAdult"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🔞 XXX"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnSeriesFilterAll"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🌍 Alle"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSeriesCats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSeriesCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Rechte Spalte: Suche, Hero Banner & Series Grid -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Obere Leiste: Suche & Kategorie-Titel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtSeriesCategoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Serien"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Integrierte Seriensuche -->
            <EditText
                android:id="@+id/editSeriesSearch"
                android:layout_width="260dp"
                android:layout_height="38dp"
                android:background="@drawable/card_focus_selector"
                android:hint="🔍 Serie suchen..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:paddingHorizontal="14dp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Kompakter Hero Banner -->
        <LinearLayout
            android:id="@+id/seriesHeroBanner"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#1E1E1E"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgHeroSeriesCover"
                android:layout_width="70dp"
                android:layout_height="96dp"
                android:scaleType="centerCrop"
                android:src="@drawable/tv_banner"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeroSeriesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Serientitel"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeroSeriesRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="⭐ 8.5 | Staffeln &amp; Folgen"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtHeroSeriesHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="▶ OK für Staffeln &amp; Episoden"
                    android:textColor="@color/netflix_red"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSeries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSeriesGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</LinearLayout>
