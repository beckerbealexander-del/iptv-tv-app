<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/card_focus_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:paddingVertical="3dp">

    <!-- Episoden-Thumbnail mit Gesehen-Fortschrittsbalken -->
    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:background="#151515">

        <ImageView
            android:id="@+id/imgEpisodeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/tv_banner" />

        <ProgressBar
            android:id="@+id/progressEpisodeWatched"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/netflix_red"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Episodennummer & Titel -->
    <TextView
        android:id="@+id/txtEpisodeNumAndTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Folge 1: Pilot"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Dauer -->
    <TextView
        android:id="@+id/txtEpisodeDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="45 Min"
        android:textColor="@color/accent_gold"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/txtEpisodePlayIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶"
        android:textColor="@color/netflix_red"
        android:textSize="14sp" />

</LinearLayout>
