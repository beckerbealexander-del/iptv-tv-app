<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal">

    <!-- Linke Spalte: Kategorien (210dp) -->
    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:background="#0B0B0B"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Film-Kategorien"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Vollbild-Suchbutton -->
        <TextView
            android:id="@+id/btnOpenVodSearch"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="🔍 Film suchen..."
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressVodCats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVodCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Rechte Spalte: Hero Banner & Movie Grid -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Kategorie-Titel -->
        <TextView
            android:id="@+id/txtVodCategoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filme"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Kompakter Hero Banner -->
        <LinearLayout
            android:id="@+id/vodHeroBanner"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#151515"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/imgHeroPoster"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/tv_banner"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeroTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Titel des Films"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="marquee" />

                <TextView
                    android:id="@+id/txtHeroRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 8.2 | VOD"
                    android:textColor="@color/accent_gold"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/txtHeroPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wähle einen Film aus dem Katalog aus oder nutze die Suche."
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Steuerungselement: Sortierleiste direkt über der Grid-Liste -->
        <LinearLayout
            android:id="@+id/layoutVodSortBar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sortierung: "
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSortDefault"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/card_focus_selector"
                android:text="⚡ Standard"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSortRating"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/card_focus_selector"
                android:text="⭐ Bewertung"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSortYear"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/card_focus_selector"
                android:text="📅 Jahr"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSortAlpha"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/card_focus_selector"
                android:text="🔤 A-Z"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressVod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 5-Spalten Movie Poster Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVodGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
