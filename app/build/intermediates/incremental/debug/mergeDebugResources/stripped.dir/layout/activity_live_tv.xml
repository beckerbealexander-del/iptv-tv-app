<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal">

    <!-- Linke Spalte: TV-Kategorien & Sprachfilter -->
    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:background="#0B0B0B"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TV-Kategorien"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Schnellauswahl Filter-Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnLiveFilterDe"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:nextFocusDown="@+id/recyclerCategories"
                android:text="🇩🇪 DE"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnLiveFilterRu"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:nextFocusDown="@+id/recyclerCategories"
                android:text="🇷🇺 RU"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnLiveFilterAdult"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:nextFocusDown="@+id/recyclerCategories"
                android:text="🔞 XXX"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnLiveFilterAll"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:nextFocusDown="@+id/recyclerCategories"
                android:text="🌍 Alle"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:nextFocusRight="@+id/recyclerChannels"
            android:nextFocusUp="@+id/btnLiveFilterDe" />
    </LinearLayout>

    <!-- Rechte Spalte: TiviMate Style EPG Timeline Grid -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 1. Obere Leiste: Sendersuche & Programmbeschreibung -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#121212"
            android:orientation="horizontal"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPreviewTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Wähle einen Sender"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPreviewTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/netflix_red"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPreviewDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Drücke OK auf der Fernbedienung, um den Sender direkt im Vollbild zu starten."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/editLiveSearch"
                android:layout_width="200dp"
                android:layout_height="36dp"
                android:background="@drawable/card_focus_selector"
                android:hint="🔍 Sender suchen..."
                android:nextFocusDown="@+id/recyclerChannels"
                android:nextFocusLeft="@+id/recyclerCategories"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:layout_marginStart="14dp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- 2. TiviMate Zeitstrahl-Kopfleiste (Vergangenheit bis Zukunft) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="#181818"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txtCurrentLiveTime"
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:text="🔴 LIVE TV GUIDE"
                android:textColor="@color/netflix_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀ Vergangenheit"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 JETZT"
                android:textColor="@color/netflix_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zukunft ▶"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 3. Senderzeilen mit horizontalem EPG Timeline Zeitstrahl -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:descendantFocusability="afterDescendants"
            android:nextFocusLeft="@+id/recyclerCategories"
            android:nextFocusUp="@+id/editLiveSearch" />
    </LinearLayout>

</LinearLayout>
