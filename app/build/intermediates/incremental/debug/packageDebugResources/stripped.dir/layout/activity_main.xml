<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal">

    <!-- 1. Netflix Symmetrische Sidebar links -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:background="#0A0A0A"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="16dp">

        <!-- Netflix Style App Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALEX TV"
            android:textColor="@color/netflix_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- 📺 Live TV -->
        <LinearLayout
            android:id="@+id/navLiveTv"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live TV"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 🎬 Filme -->
        <LinearLayout
            android:id="@+id/navMovies"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filme"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 🍿 Serien -->
        <LinearLayout
            android:id="@+id/navSeries"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍿"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serien"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ⚙️ Optionen -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/card_focus_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Optionen"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- 2. Hauptbereich: Perfekt symmetrisch aufgeteilte 3 Verlaufs-Reihen -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#000000"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <!-- Row 1: 📺 TV-Sender Verlauf (Höhe 78dp) -->
        <LinearLayout
            android:id="@+id/layoutSectionChannelHistory"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:orientation="vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📺 Live TV – Zuletzt geschaut"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/txtNoChannelHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Noch keine TV-Sender geschaut. Klicke links auf 'Live TV', um Sender zu starten."
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChannelHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Row 2: 🍿 Serien-Verlauf & Weiterschauen (Höhe 185dp) -->
        <LinearLayout
            android:id="@+id/layoutSectionSeriesHistory"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:orientation="vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍿 Serien – Weiterschauen &amp; Verlauf"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/txtNoSeriesHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Noch keine Serien geschaut. Klicke links auf 'Serien', um eine Serie zu starten."
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSeriesHistory"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Row 3: 🎬 Film-Verlauf & Weiterschauen (Höhe 185dp) -->
        <LinearLayout
            android:id="@+id/layoutSectionMovieHistory"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎬 Filme – Weiterschauen &amp; Verlauf"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/txtNoMovieHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Noch keine Filme geschaut. Klicke links auf 'Filme', um Filme zu starten."
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMovieHistory"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="horizontal" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
