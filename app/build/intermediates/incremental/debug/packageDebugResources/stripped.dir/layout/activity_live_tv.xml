<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="horizontal">

    <!-- Linke Spalte: Suche + Filter + TV-Kategorien -->
    <LinearLayout
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:background="#0B0B0B"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TV-Kategorien"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- 1. Suchleiste ÜBER den Filter-Buttons -->
        <EditText
            android:id="@+id/editLiveSearch"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/card_focus_selector"
            android:hint="🔍 Sender suchen..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="11sp"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:layout_marginBottom="6dp" />

        <!-- 2. Schnellauswahl Filter-Buttons (DE, RU, Alle) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnLiveFilterDe"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🇩🇪 DE"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnLiveFilterRu"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🇷🇺 RU"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btnLiveFilterAll"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/card_focus_selector"
                android:text="🌍 Alle"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <!-- Rechte Spalte: TiviMate Style EPG Timeline Grid + PIP Mini-Player -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 1. Obere Leiste: PIP Mini-Player (Live TV Vorschau mit Audio) + Sendungsinfos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:background="#121212"
            android:orientation="horizontal"
            android:padding="6dp"
            android:layout_marginBottom="6dp">

            <!-- PIP Mini-Player Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="6dp"
                app:cardBackgroundColor="#000000">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/livePipPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    app:resize_mode="zoom" />
            </androidx.cardview.widget.CardView>

            <!-- Sendungsinfos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPreviewTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Wähle einen Sender"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPreviewTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/netflix_red"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPreviewDesc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:text="Drücke OK auf der Fernbedienung, um den Sender im Vollbild zu starten."
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. TiviMate Zeitstrahl-Kopfleiste (Vergangenheit bis Zukunft) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="#181818"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/txtCurrentLiveTime"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="🔴 LIVE TV GUIDE"
                android:textColor="@color/netflix_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀ Vergangenheit"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 JETZT"
                android:textColor="@color/netflix_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zukunft ▶"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 3. Senderzeilen mit horizontalem EPG Timeline Zeitstrahl -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

</LinearLayout>
