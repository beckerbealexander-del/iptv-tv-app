<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- ExoPlayer Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Lade-Spinner -->
    <ProgressBar
        android:id="@+id/playerLoading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Netflix-Style Mittlerer Spul-Indikator -->
    <LinearLayout
        android:id="@+id/osdScrubBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/card_focus_selector"
        android:paddingHorizontal="28dp"
        android:paddingVertical="14dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtScrubSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏩ +30s"
            android:textColor="@color/accent_gold"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtScrubTargetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="00:25:40"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Top OSD: Titel & Badges -->
    <LinearLayout
        android:id="@+id/osdTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B30B0E14"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Titel"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Qualitäts Badge -->
        <TextView
            android:id="@+id/badgeQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_focus_selector"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="HD"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <!-- Audio Info Badge -->
        <TextView
            android:id="@+id/badgeAudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_focus_selector"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Stereo"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom OSD: Dezent, schlank & elegant -->
    <LinearLayout
        android:id="@+id/osdBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B30B0E14"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- Live EPG Untertitel / Info -->
        <TextView
            android:id="@+id/txtPlayerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/accent_gold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <!-- Timeline Zeitleiste & SeekBar -->
        <LinearLayout
            android:id="@+id/layoutTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/txtTimeCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="10dp" />

            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:focusable="true"
                android:nextFocusDown="@+id/btnAudioTracks"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:id="@+id/txtTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Schlanke Steuerleiste: Tonspur, Untertitel, Nächste / Vorherige Folge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevEpisode"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/card_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/playerSeekBar"
                android:text="⏮ Vorherige Folge"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNextEpisode"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/card_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/playerSeekBar"
                android:text="⏭ Nächste Folge"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAudioTracks"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/card_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/playerSeekBar"
                android:text="🔊 Tonspur"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSubtitles"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/card_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusUp="@+id/playerSeekBar"
                android:text="💬 Untertitel"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtHintControls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="OK: Pause | ◀/▶: Spulen | ▲: Menü"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
