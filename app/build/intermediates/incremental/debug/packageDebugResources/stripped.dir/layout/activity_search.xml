<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header & Search Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="28sp"
            android:layout_marginEnd="14dp" />

        <EditText
            android:id="@+id/editSearchQuery"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/card_focus_selector"
            android:hint="Film, Serie oder Sender suchen (z.B. Sky, ZDF, Avatar, Breaking Bad)..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="18sp"
            android:paddingHorizontal="20dp"
            android:inputType="text"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/btnSearchClear"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:background="@drawable/card_focus_selector"
            android:text="Löschen"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Resultate: Horizontal / Scrollbare Listen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Live Sender -->
            <TextView
                android:id="@+id/headerChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📺 Gefundene TV-Sender"
                android:textColor="@color/accent_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSearchChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <!-- 2. Filme (VOD) -->
            <TextView
                android:id="@+id/headerMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎬 Gefundene Filme"
                android:textColor="@color/accent_gold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSearchMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <!-- 3. Serien -->
            <TextView
                android:id="@+id/headerSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍿 Gefundene Serien"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSearchSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtNoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="Tippe oben einen Suchbegriff ein"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
